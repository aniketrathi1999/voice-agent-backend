# LiveKit Configuration
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI Services
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# STT Configuration
STT_PROVIDER=deepgram
DG_MODEL=nova-2
DG_LANG=en

# LLM Configuration
LLM_MODEL=gpt-4o-mini

# TTS Configuration
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=ash
CARTESIA_MODEL=gpt-4o-mini
CARTESIA_VOICE=ash
SSML_ENABLE=true

# Conversation Flow
MIN_ENDPOINTING_DELAY=0.2
MAX_ENDPOINTING_DELAY=6.0
ALLOW_INTERRUPTIONS=true
PREEMPTIVE_GENERATION=false

# Early Response Settings (experimental_agent_e4.py)
EARLY_CONF_THRESHOLD=0.70
EARLY_MIN_CHARS=25
EARLY_MODE=threshold  # 'off' or 'threshold'

# End-of-Turn Detection (experimental_agent_e2.py)
EOT_CONF_THRESH=0.9
MIN_EOT_SILENCE_MS=100
MAX_TURN_SILENCE_MS=1000

# Langfuse Integration
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Feedback & Monitoring
FINAL_FEEDBACK_WAIT=7  # seconds to wait for feedback at shutdown
